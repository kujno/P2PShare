<Window x:Class="P2PShare.ConnectionToServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P2PShare"
        mc:Ignorable="d"
        Title="ConnectionToServer" Height="225" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#333333"
        BorderThickness="1px"
        MouseDown="Window_MouseDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="Foreground" Value="#c2c2c2"/>
            </Style>
        </Grid.Resources>

        <TextBlock x:Name="Text" Grid.Row="0" FontSize="20px" HorizontalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center"/>    
            
        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="0, 0, 0, 45px">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#292929"/>
                    <Setter Property="Foreground" Value="#c2c2c2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Height" Value="20px"/>
                    <Setter Property="Width" Value="70px"/>
                </Style>
            </StackPanel.Resources>

            <Button Visibility="Hidden" Content="Change server IP" Margin="0" Click="ChangeIP_Click"/>
            <Button Visibility="Hidden" Content="Try again" Margin="70px, 0, 0, 0" Click="TryAgain_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="5px" TextDecorations="Underline" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown">
            Continue without server
        </TextBlock>
    </Grid>
</Window>
