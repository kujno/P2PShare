<Window x:Class="P2PShare.NewFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P2PShare"
        mc:Ignorable="d"
        Title="NewFolder" Height="225" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#333333"
        BorderThickness="1px"
        MouseDown="Window_MouseDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="GroupBoxHeader" Header="New folder name:" Width="250px" Foreground="#c2c2c2" BorderThickness="0"  Grid.Row="0" VerticalAlignment="Bottom" Margin="0, 30px">
            <TextBox x:Name="TextBoxFolderName" FontSize="18px" FontFamily="Arial"/>
        </GroupBox>
        <StackPanel VerticalAlignment="Bottom" Orientation="Vertical" HorizontalAlignment="Center" Grid.Row="1" Margin="0, 0, 0, 25px">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#292929"/>
                    <Setter Property="Foreground" Value="#c2c2c2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Height" Value="20px"/>
                    <Setter Property="Width" Value="70px"/>
                </Style>

                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Arial"/>
                </Style>
            </StackPanel.Resources>

            <TextBlock x:Name="TextBlockValid" Margin="0, 0, 0, 10px" Foreground="Red" Visibility="Collapsed"/>

            <Button Content="OK" Margin="0, 0, 0, 20px" Click="OK_Click"/>

            <TextBlock x:Name="TextBlockExit" Foreground="#c2c2c2" Cursor="Hand" TextAlignment="Center" TextDecorations="Underline" MouseLeftButtonDown="TextBlockExit_MouseLeftButtonDown">
                Cancel
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
